<%- include('_head') %>
<div class="p-head"><div><h1>Leads &amp; follow-ups</h1><div class="sub">Contact, service and "ask about this vehicle" requests from the website.</div></div></div>
<div class="p-body"><%- include('_flash') %><div class="tbl"><table><thead><tr><th>Who</th><th>Type</th><th>Message</th><th>When</th><th>Status</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="5" class="muted" style="padding:30px;text-align:center">No leads yet.</td></tr><% } %>
<% for (const l of rows) { %><tr class="<%= l.status === 'new' ? 'new' : '' %>"><td><div class="t"><%= l.name %></div><div class="s"><a href="sms:+1<%= l.phone %>"><%= u.fmtPhone(l.phone) %></a><%= l.email ? ' · ' + l.email : '' %></div></td><td><span class="pill pill-<%= l.type === 'service' ? 'blue' : l.type === 'vehicle' ? 'gold' : 'ink' %>"><%= l.type %></span><% if (l.vehicle_stock) { %><div class="s">Stock #<%= l.vehicle_stock %></div><% } %></td><td style="max-width:380px;white-space:pre-line"><%= l.message %><% if (l.preferred_date) { %><div class="s">Prefers: <%= l.preferred_date %></div><% } %></td><td><%= u.timeAgo(l.created_at) %><div class="s"><%= u.fmtTime(l.created_at) %></div></td><td><form method="post" action="/portal/leads/<%= l.id %>/status"><select class="input" name="status" style="height:34px;font-size:13px" onchange="this.form.submit()"><% for (const s of ['new', 'contacted', 'closed']) { %><option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= s %></option><% } %></select></form></td></tr><% } %>
</tbody></table></div></div><%- include('_foot') %>

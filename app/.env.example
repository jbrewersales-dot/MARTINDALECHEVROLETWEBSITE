# Copy to .env and fill in. setup.sh generates a real one for you on the server.
PORT=3000
# Random 64-hex-character strings. Never change APP_ENCRYPTION_KEY after applications exist,
# or the stored SSNs/DOBs can no longer be decrypted.
SESSION_SECRET=change-me
APP_ENCRYPTION_KEY=change-me-64-hex-chars
# Where the SQLite database and uploads live
DATA_DIR=./data
# First staff login, created only if no users exist yet
ADMIN_EMAIL=jbrewersales@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
# Optional: email alerts when a credit application or lead comes in
NOTIFY_TO=jbrewersales@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Public site URL, used in emails
SITE_URL=http://localhost:3000
